{
  "name": "geekchart",
  "version": "0.1.0",
  "type": "module",
  "description": "Paste a mermaid chart, get an animated one in the 4geeks look — a React component, a server renderer, and a CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaficMikati/GeekChart.git",
    "directory": "packages/geekchart"
  },
  "homepage": "https://github.com/WaficMikati/GeekChart#readme",
  "bugs": "https://github.com/WaficMikati/GeekChart/issues",
  "bin": {
    "geekchart": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./cli": {
      "default": "./dist/cli.js"
    },
    "./fonts.css": "./dist/fonts.css",
    "./fonts-manim.css": "./dist/fonts-manim.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "size": "node scripts/size.mjs",
    "lint": "eslint src test",
    "pretest": "pnpm --filter @geekchart/cli build && node build.mjs",
    "test": "node --test test/*.test.mts"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "dependencies": {
    "@mermaid-js/layout-elk": "^0.2.2",
    "elkjs": "^0.12.0",
    "fontkit": "^2.0.4",
    "linkedom": "^0.18.13",
    "mermaid": "11.12.0"
  },
  "devDependencies": {
    "@geekchart/core": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
